   "source": [
    "stop_thread(thread3)\n",
    "\n",
    "if len(bias_values) > 0:\n",
    "    mean_abs_bias = np.mean(bias_values)\n",
    "else:\n",
    "    mean_abs_bias = 0\n",
    "\n",
    "if len(recovery_times) > 0:\n",
    "    avg_recovery_time = sum(recovery_times) / len(recovery_times)\n",
    "else:\n",
    "    avg_recovery_time = 0\n",
    "\n",
    "print(\"===== RUN RESULTS =====\")\n",
    "print(f\"Mean |Bias|: {mean_abs_bias:.2f}\")\n",
    "print(f\"Lost Line Count: {lost_line_count}\")\n",
    "print(f\"Average Recovery Time: {avg_recovery_time:.2f} s\")\n"
    "#Stop the car movement\n",
    "bot.Ctrl_Ulatist_Switch(0)\n",
    "bot.Ctrl_BEEP_Switch(0)\n",
    "stop()\n",
    "image.release()"
   ]
