    "roi_shift = 0\n",
    "lost_line_count = 0\n",
    "prev_lost_line = False\n",
    "rotate_count = 0\n",
    "last_rotate = \"\"\n",
    "running = True\n",
    "recovery_times = []\n",
    "recovery_start_time = None\n",
    "is_recovering = False\n",
    "display(image_widget)\n",
    "bias_values = []\n",
    "thread3 = threading.Thread(target=Camera_display)\n",
    "thread3.setdaemon=True\n",
    "thread3.start()"
