    "global Z_axis_pid\n",
    "Z_axis_pid = PID.PositionalPID(0.5, 0, 1) \n",
    "global prev_left\n",
    "prev_left = 0\n",
    "global prev_right\n",
    "prev_right = 0\n",
    "global flag\n",
    "flag=1"
   ]
