    "def Camera_display():\n",
    "    global peaks_count\n",
    "    global prev_left, prev_right, flag\n",
    "    global Z_axis_pid\n",
    "    global bias_values\n",
    "    global roi_shift\n",
    "    global lost_line_count, prev_lost_line\n",
    "    global rotate_count, last_rotate\n",
    "    global running\n",
    "    global recovery_times, recovery_start_time, is_recovering\n",
    "\n",
    "    t_start = time.time()\n",
    "    fps = 0\n",
    "\n",
    "    bot.Ctrl_Ulatist_Switch(1)\n",
    "\n",
    "    while running:\n",
    "        ret, frame = image.read()\n",
    "\n",
    "        fps = fps + 1\n",
    "        mfps = fps / (time.time() - t_start)\n",
    "        cv2.putText(frame, \"FPS: \" + str(int(mfps)), (80,80),\n",
    "                    cv2.FONT_HERSHEY_SIMPLEX, 3.0, (0,255,255), 8)\n",
    "\n",
    "        frame = cv2.resize(frame, (320,240))\n",
    "\n",
    "        matSrc = np.float32([\n",
    "            [20 + roi_shift, 225],\n",
    "            [300 + roi_shift, 225],\n",
    "            [250 + roi_shift, 145],\n",
    "            [70 + roi_shift, 145]\n",
    "        ])\n",
    "        matDst = np.float32([[0,240], [320,240], [320,0], [0,0]])\n",
    "        matAffine = cv2.getPerspectiveTransform(matSrc, matDst)\n",
    "        dst = cv2.warpPerspective(frame, matAffine, (320,240))\n",
    "\n",
    "        pts = np.array([\n",
    "            [20 + roi_shift, 225],\n",
    "            [300 + roi_shift, 225],\n",
    "            [250 + roi_shift, 145],\n",
    "            [70 + roi_shift, 145]\n",
    "        ], np.int32)\n",
    "\n",
    "        pts = pts.reshape((-1, 1, 2))\n",
    "        cv2.polylines(frame, [pts], True, (255, 0, 0), 3)\n",
    "\n",
    "        dst_gray = cv2.cvtColor(dst, cv2.COLOR_BGR2GRAY)\n",
    "        dst_gray = cv2.GaussianBlur(dst_gray, (5,5), 0)\n",
    "        dst_retval, dst_binaryzation = cv2.threshold(dst_gray, 110, 255, cv2.THRESH_BINARY)\n",
    "        dst_binaryzation = cv2.erode(dst_binaryzation, None, iterations=1)\n",
    "\n",
    "        histogram = np.sum(dst_binaryzation[dst_binaryzation.shape[0]//2:, :], axis=0)\n",
    "        midpoint = np.int_(histogram.shape[0]/2)\n",
    "\n",
    "        left_sum = np.sum(histogram[:20], axis=0)\n",
    "        right_sum = np.sum(histogram[300:], axis=0)\n",
    "\n",
    "        rightpoint = 320\n",
    "        center_r = 159\n",
    "\n",
    "        leftx_base = np.argmin(histogram[:rightpoint], axis=0)\n",
    "        rightx_base = np.argmin(histogram[::-1][:rightpoint], axis=0)\n",
    "        rightx_base = 319 - rightx_base\n",
    "\n",
    "        if leftx_base == 0 and rightx_base == 319:\n",
    "            current_lost_line = True\n",
    "        else:\n",
    "            current_lost_line = False\n",
    "\n",
    "        if current_lost_line and not prev_lost_line:\n",
    "            lost_line_count += 1\n",
    "            recovery_start_time = time.time()\n",
    "            is_recovering = True\n",
    "\n",
    "        if (not current_lost_line) and prev_lost_line and is_recovering:\n",
    "            recovery_time = time.time() - recovery_start_time\n",
    "            recovery_times.append(recovery_time)\n",
    "            is_recovering = False\n",
    "            recovery_start_time = None\n",
    "\n",
    "        prev_lost_line = current_lost_line\n",
    "\n",
    "        dst_binaryzation = cv2.cvtColor(dst_binaryzation, cv2.COLOR_GRAY2RGB)\n",
    "        cv2.line(dst_binaryzation, (159,0), (159,240), (255,0,255), 2)\n",
    "\n",
    "        lane_center = int((leftx_base + rightx_base)/2)\n",
    "\n",
    "        cv2.line(dst_binaryzation, (leftx_base,0), (leftx_base,240), (0,255,0), 2)\n",
    "        cv2.line(dst_binaryzation, (rightx_base,0), (rightx_base,240), (0,255,0), 2)\n",
    "        cv2.line(dst_binaryzation, (lane_center,0), (lane_center,240), (255,0,0), 2)\n",
    "\n",
    "        left_sum_value = int(np.sum(histogram[:center_r], axis=0))/159\n",
    "        right_sum_value = int(np.sum(histogram[center_r:], axis=0))/159\n",
    "\n",
    "        Bias = 159 - lane_center\n",
    "\n",
    "        roi_shift = int(-Bias * 0.1)\n",
    "        if roi_shift > 25:\n",
    "            roi_shift = 25\n",
    "        elif roi_shift < -25:\n",
    "            roi_shift = -25\n",
    "\n",
    "        abs_bias = abs(Bias)\n",
    "        bias_values.append(abs_bias)\n",
    "\n",
    "\n",
    "        cv2.putText(dst_binaryzation, \"FPS:  \" + str(int(mfps)), (10,15),\n",
    "                    cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0,255,255), 1)\n",
    "        cv2.putText(dst_binaryzation, \"Bias: \" + str(int(Bias)), (10,35),\n",
    "                    cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0,255,255), 1)\n",
    "\n",
    "        Z_axis_pid.SystemOutput = Bias\n",
    "        Z_axis_pid.SetStepSignal(20)\n",
    "        Z_axis_pid.SetInertiaTime(0.5, 0.2)\n",
    "\n",
    "        if Z_axis_pid.SystemOutput > 20:\n",
    "            Z_axis_pid.SystemOutput = 20\n",
    "        elif Z_axis_pid.SystemOutput < -20:\n",
    "            Z_axis_pid.SystemOutput = -20\n",
    "\n",
    "        TurnZ_PID_slider.value = int(Z_axis_pid.SystemOutput)\n",
    "\n",
    "        speed = 20\n",
    "\n",
    "        #Reading distance from ultrasonic sensor\n",
    "        diss_H = bot.read_data_array(0x1b,1)[0]\n",
    "        diss_L = bot.read_data_array(0x1a,1)[0]\n",
    "        dis = diss_H << 8 | diss_L\n",
    "\n",
    "        if dis < 200:\n",
    "            stop_robot()\n",
    "            bot.Ctrl_BEEP_Switch(1)\n",
    "            time.sleep(0.05)\n",
    "            bot.Ctrl_BEEP_Switch(0)\n",
    "\n",
    "        else:\n",
    "            # anti-stuck recovery\n",
    "            if rotate_count >= 10:\n",
    "                move_forward(speed)\n",
    "                time.sleep(0.2)\n",
    "                rotate_count = 0\n",
    "                last_rotate = \"\"\n",
    "\n",
    "            if leftx_base == 0 and rightx_base == 319:\n",
    "                if prev_left > prev_right:\n",
    "                    rotate_left(speed)\n",
    "                elif prev_left < prev_right:\n",
    "                    rotate_right(speed)\n",
    "\n",
    "                prev_left = 0\n",
    "                prev_right = 0\n",
    "\n",
    "            else:\n",
    "                if Bias > 35:\n",
    "                    if Bias > 140:\n",
    "                        rotate_left(int((speed - Z_axis_pid.SystemOutput)/5))\n",
    "                        if last_rotate == \"left\":\n",
    "                            rotate_count += 1\n",
    "                        else:\n",
    "                            rotate_count = 1\n",
    "                            last_rotate = \"left\"\n",
    "                        prev_left = 0\n",
    "                        prev_right = 0\n",
    "\n",
    "                    elif Bias < 50:\n",
    "                        move_left(int((speed/15)))\n",
    "                        rotate_count = 0\n",
    "                        last_rotate = \"\"\n",
    "\n",
    "                    else:\n",
    "                        move_forward(speed)\n",
    "                        rotate_count = 0\n",
    "                        last_rotate = \"\"\n",
    "\n",
    "                    time.sleep(0.001)\n",
    "\n",
    "                elif Bias < -35:\n",
    "                    if Bias < -140:\n",
    "                        rotate_right(int((speed + Z_axis_pid.SystemOutput)/5))\n",
    "                        if last_rotate == \"right\":\n",
    "                            rotate_count += 1\n",
    "                        else:\n",
    "                            rotate_count = 1\n",
    "                            last_rotate = \"right\"\n",
    "                        prev_left = 0\n",
    "                        prev_right = 0\n",
    "\n",
    "                    elif Bias > -45:\n",
    "                        move_right(int((speed/15)))\n",
    "                        rotate_count = 0\n",
    "                        last_rotate = \"\"\n",
    "\n",
    "                    else:\n",
    "                        move_forward(speed)\n",
    "                        rotate_count = 0\n",
    "                        last_rotate = \"\"\n",
    "\n",
    "                    time.sleep(0.001)\n",
    "\n",
    "                else:\n",
    "                    move_forward(speed)\n",
    "                    rotate_count = 0\n",
    "                    last_rotate = \"\"\n",
    "\n",
    "        if left_sum != right_sum:\n",
    "            if left_sum < right_sum:\n",
    "                prev_left = prev_left + 1\n",
    "            elif right_sum < left_sum:\n",
    "                prev_right = prev_right + 1\n",
    "\n",
    "        image_widget.value = bgr8_to_jpeg(frame)\n",
    "        image_widget_1.value = bgr8_to_jpeg(dst)\n",
    "        image_widget_2.value = bgr8_to_jpeg(dst_binaryzation)\n",
    "    \n",
    "        "
   ]
  },
