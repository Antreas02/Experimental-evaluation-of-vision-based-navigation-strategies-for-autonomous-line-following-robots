flag=1


def Camera_display():
    global peaks_count
    global prev_left, prev_right, flag
    global Z_axis_pid
    global bias_values
    global lost_line_count, prev_lost_line
    global rotate_count, last_rotate
    global running
    global recovery_times, recovery_start_time, is_recovering

    t_start = time.time()
    fps = 0
    bot.Ctrl_Ulatist_Switch(1)
    while running:
        ret, frame = image.read()

        if not ret or frame is None:
            continue

        fps = fps + 1
        mfps = fps / (time.time() - t_start)
        cv2.putText(frame, "FPS: " + str(int(mfps)), (80,80), cv2.FONT_HERSHEY_SIMPLEX, 3.0, (0,255,255), 8)

        frame = cv2.resize(frame,(320,240))


        matSrc = np.float32([[20, 225], [300, 225], [250, 145], [70, 145]])
        matDst = np.float32([[0,240], [320,240], [320,0], [0,0]])
        matAffine = cv2.getPerspectiveTransform(matSrc,matDst)
        dst = cv2.warpPerspective(frame,matAffine,(320,240))

        pts = np.array([[20, 225], [300, 225], [250, 145], [70, 145]], np.int32)
        pts = pts.reshape((-1, 1, 2))
        cv2.polylines(frame, [pts],True, (255, 0, 0), 3)

        dst_gray = cv2.cvtColor(dst, cv2.COLOR_BGR2GRAY)
        dst_gray = cv2.GaussianBlur(dst_gray, (5,5), 0)

        mean_val = np.mean(dst_gray)
        thresh_val = int(mean_val - 40)

        if thresh_val < 0:
            thresh_val = 0
        elif thresh_val > 255:
            thresh_val = 255

        dst_retval, dst_binaryzation = cv2.threshold(dst_gray, thresh_val, 255, cv2.THRESH_BINARY)

        dst_binaryzation = cv2.erode(dst_binaryzation, None, iterations=1)


        histogram = np.sum(dst_binaryzation[dst_binaryzation.shape[0]//2:, :], axis=0)
        midpoint = np.int_(histogram.shape[0]/2)

        left_sum = np.sum(histogram[:20], axis=0)
        right_sum = np.sum(histogram[300:], axis=0)


        rightpoint = 320
        center_r = 159

        leftx_base = np.argmin(histogram[:rightpoint], axis = 0)
        rightx_base = np.argmin(histogram[::-1][:rightpoint], axis = 0)
        rightx_base = 319 - rightx_base

        if leftx_base == 0 and rightx_base == 319:
            current_lost_line = True
        else:
            current_lost_line = False

        if current_lost_line and not prev_lost_line:
            lost_line_count += 1
            recovery_start_time = time.time()
            is_recovering = True

        if (not current_lost_line) and prev_lost_line and is_recovering:
            recovery_time = time.time() - recovery_start_time
            recovery_times.append(recovery_time)
            is_recovering = False
            recovery_start_time = None

        prev_lost_line = current_lost_line

        dst_binaryzation = cv2.cvtColor(dst_binaryzation,cv2.COLOR_GRAY2RGB)
        cv2.line(dst_binaryzation,(159,0),(159,240),(255,0,255),2)
        lane_center = int((leftx_base + rightx_base)/2)
        cv2.putText(dst_binaryzation, "Thresh: " + str(int(thresh_val)), (10,55),
            cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0,255,255), 1)

        cv2.line(dst_binaryzation,(leftx_base,0),(leftx_base,240),(0,255,0),2)
        cv2.line(dst_binaryzation,(rightx_base,0),(rightx_base,240),(0,255,0),2)
        cv2.line(dst_binaryzation,(lane_center,0),(lane_center,240),(255,0,0),2)

        left_sum_value = int(np.sum(histogram[:center_r], axis = 0))/159
        right_sum_value = int(np.sum(histogram[center_r:], axis = 0))/159

        Bias = 159 - lane_center

        abs_bias = abs(Bias)
        bias_values.append(abs_bias)

        cv2.putText(dst_binaryzation, "FPS:  " + str(int(mfps)), (10,15), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0,255,255), 1)
        cv2.putText(dst_binaryzation, "Bias: " + str(int(Bias)), (10,35), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0,255,255), 1)

        Z_axis_pid.SystemOutput = Bias
        Z_axis_pid.SetStepSignal(20)
        Z_axis_pid.SetInertiaTime(0.5, 0.2)


        if Z_axis_pid.SystemOutput > 20:
            Z_axis_pid.SystemOutput = 20
        elif Z_axis_pid.SystemOutput < -20:
            Z_axis_pid.SystemOutput = -20

        TurnZ_PID_slider.value = int(Z_axis_pid.SystemOutput)

        speed=20

        #Reading distance from ultrasonic sensor
        diss_H =bot.read_data_array(0x1b,1)[0]
        diss_L =bot.read_data_array(0x1a,1)[0]
        dis = diss_H << 8 | diss_L
        if(dis <200):
            stop_robot()
            bot.Ctrl_BEEP_Switch(1)
            time.sleep(0.05)
            bot.Ctrl_BEEP_Switch(0)
        else:
            # anti-stuck recovery
            if rotate_count >= 10:
                move_forward(speed)
                time.sleep(0.2)
                rotate_count = 0
                last_rotate = ""

            if leftx_base == 0 and rightx_base == 319:
                if prev_left > prev_right:
                    rotate_left(speed)
                elif prev_left < prev_right:
                    rotate_right(speed)

                prev_left = 0
                prev_right = 0

            else:
                if Bias > 35:
                    if Bias > 140:
                        rotate_left(int((speed - Z_axis_pid.SystemOutput)/5))
                        if last_rotate == "left":
                            rotate_count += 1
                        else:
                            rotate_count = 1
                            last_rotate = "left"
                        prev_left = 0
                        prev_right = 0

                    elif Bias < 50:
                        move_left(int((speed/15)))
                        rotate_count = 0
                        last_rotate = ""

                    else:
                        move_forward(speed)
                        rotate_count = 0
                        last_rotate = ""

                    time.sleep(0.001)

                elif Bias < -35:
                    if Bias < -140:
                        rotate_right(int((speed + Z_axis_pid.SystemOutput)/5))
                        if last_rotate == "right":
                            rotate_count += 1
                        else:
                            rotate_count = 1
                            last_rotate = "right"
                        prev_left = 0
                        prev_right = 0

                    elif Bias > -45:
                        move_right(int((speed/15)))
                        rotate_count = 0
                        last_rotate = ""

                    else:
                        move_forward(speed)
                        rotate_count = 0
                        last_rotate = ""

                    time.sleep(0.001)

                else:
                    move_forward(speed)
                    rotate_count = 0
                    last_rotate = ""

        if left_sum != right_sum:
            if left_sum < right_sum:
                prev_left = prev_left + 1
            elif right_sum < left_sum:
                prev_right = prev_right + 1


        image_widget.value = bgr8_to_jpeg(frame)
        image_widget_1.value = bgr8_to_jpeg(dst)
        image_widget_2.value = bgr8_to_jpeg(dst_binaryzation)


lost_line_count = 0
